{
	"manifest_version": 3,
	"name": "Mira – Auto Clicker",
	"version": "1.0.0",
	"description": "Clica sozinho num ponto da página. Clique no ícone para abrir o painel, marque o ponto e aperte Iniciar.",
	"icons": {
		"16": "icons/16.png",
		"32": "icons/32.png",
		"48": "icons/48.png",
		"128": "icons/128.png"
	},
	"action": {
		"default_title": "Mira: abrir / fechar o painel",
		"default_icon": {
			"16": "icons/16.png",
			"32": "icons/32.png"
		}
	},
	"background": {
		"service_worker": "background.js"
	},
	"permissions": ["activeTab", "scripting"],
	"commands": {
		"_execute_action": {
			"suggested_key": { "default": "Alt+Shift+A" },
			"description": "Abrir / fechar o painel da Mira"
		}
	}
}
